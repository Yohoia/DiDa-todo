# Environment Variables Example
# Copy this file to .env.local and fill in your actual values
# DO NOT commit .env.local to version control

# Supabase（账号注册/登录必需）
# 从 Supabase 项目 Settings → API 获取；匿名公钥配合数据库 RLS 使用
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 邮件（验证码/密码重置）不使用环境变量：
# Supabase Dashboard → Auth → SMTP Settings 配置 Resend 自定义 SMTP，
# 邮件模板见 docs/email-templates/，/auth/callback 需加入 Redirect URLs。

# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser
# Keep server-only secrets (like service role keys) without the prefix
# SUPABASE_SERVICE_ROLE_KEY 当前未使用，仅服务端确实需要时再启用

# Optional server-side profile overrides used by the profile API preview
# DIDA_PROFILE_NAME=Alex
# DIDA_PROFILE_AVATAR_URL=https://example.com/avatar.jpg

# Voice-to-Todo (server-side only; see docs/voice-todo-plan.md)
# DASHSCOPE_API_KEY=            # Aliyun Bailian key, required for /api/voice/transcribe (qwen-audio-3.0-asr-flash)
# DEEPSEEK_API_KEY=             # DeepSeek key for /api/voice/parse (deepseek-flash); falls back to DASHSCOPE_API_KEY
# VOICE_LLM_BASE_URL=https://api.deepseek.com/v1
# VOICE_LLM_MODEL=deepseek-flash
# The API key and endpoint must be from the same Bailian region:
# Singapore workspace (default): https://ws-9mlt2qkeiwpfmr0z.ap-southeast-1.maas.aliyuncs.com
# Singapore shared: https://dashscope-intl.aliyuncs.com
# Beijing: https://dashscope.aliyuncs.com
# VOICE_ASR_BASE_URL=https://ws-9mlt2qkeiwpfmr0z.ap-southeast-1.maas.aliyuncs.com
# VOICE_ASR_MODEL=qwen-audio-3.0-asr-flash
# VOICE_ALLOWED_ORIGINS=https://preview.example.com,https://app.example.com
