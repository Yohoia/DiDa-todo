# Environment Variables Example
# Copy this file to .env.local and fill in your actual values
# DO NOT commit .env.local to version control

# Future Supabase Configuration (Phase 1: Todo + Auth)
# NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Only variables prefixed with NEXT_PUBLIC_ are exposed to the browser
# Keep server-only secrets (like service role keys) without the prefix

# Optional server-side profile overrides used by the profile API preview
# DIDA_PROFILE_NAME=Alex
# DIDA_PROFILE_AVATAR_URL=https://example.com/avatar.jpg
